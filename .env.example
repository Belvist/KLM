# KLM Gateway
KLM_PORT=3100
KLM_HOST=0.0.0.0
KLM_API_KEY=klm_dev_key_change_me

# State store: file (dev only) | postgres (recommended API+MCP) | memory
KLM_STORE_BACKEND=postgres
KLM_STATE_PATH=./.klm-data
KLM_ENV=development

# PostgreSQL — shared memory for API + MCP (run: docker compose up -d && pnpm db:migrate)
DATABASE_URL=postgresql://klm:klm@localhost:5432/klm

# Model providers (BYOK — bring your own keys)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Default routing
KLM_DEFAULT_PROVIDER=openrouter
KLM_DEFAULT_MODEL=anthropic/claude-sonnet-4

# Semantic memory — explicit opt-in (requires OPENAI_API_KEY + PostgreSQL + migration 002)
KLM_SEMANTIC_MEMORY=false
KLM_EMBEDDING_MODEL=text-embedding-3-small

# Demo seed IDs (pnpm db:seed) — e2e and record:demo
KLM_DEMO_ORG_ID=00000000-0000-4000-8000-000000000001
KLM_DEMO_WORKSPACE_ID=00000000-0000-4000-8000-000000000002
KLM_DEMO_PROJECT_ID=00000000-0000-4000-8000-000000000003
KLM_DEMO_USER_ID=00000000-0000-4000-8000-000000000004

# Live project — KLM Runtime MCP when developing KLM itself (NOT external repos)
KLM_LIVE_PROJECT_ID=00000000-0000-4000-8000-000000000005

# External repo — music-platform / Earflow (isolated from KLM Runtime seed)
KLM_MUSIC_PROJECT_ID=00000000-0000-4000-8000-000000000105
# KLM_MUSIC_PLATFORM_ROOT=C:\Users\You\Downloads\music-platform

# Active profile default (switch: pnpm use:klm | pnpm use:music)
KLM_PROJECT_ID=00000000-0000-4000-8000-000000000105
KLM_ORGANIZATION_ID=00000000-0000-4000-8000-000000000001
KLM_WORKSPACE_ID=00000000-0000-4000-8000-000000000002
KLM_USER_ID=00000000-0000-4000-8000-000000000004

# Observability — never expose full event/chunk content via API (overrides ?includeContent=true)
KLM_OBSERVABILITY_REDACT_CONTENT=false

# Codebase indexer — max source file size (bytes); default 256 KB
# KLM_CODEBASE_MAX_FILE_BYTES=262144

# Runtime codebase activation — inject indexed metadata into reasoning (requires index + DATABASE_URL)
KLM_CODEBASE_ACTIVATION=true
KLM_CODEBASE_ACTIVATION_LIMIT=50

# Memory pipeline — structured extraction limits
KLM_MEMORY_EXTRACT_LIMIT=10
KLM_MEMORY_EVENT_SNIPPET_CHARS=800

# Semantic memory in CI/e2e: use mock embeddings (no OpenAI key required)
# KLM_SEMANTIC_MEMORY=true
# KLM_EMBEDDING_PROVIDER=mock
