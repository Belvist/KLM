# KLM Gateway
KLM_PORT=3100
KLM_HOST=0.0.0.0
KLM_API_KEY=klm_dev_key_change_me

# State store: file (default) | postgres | memory
KLM_STORE_BACKEND=file
KLM_STATE_PATH=./.klm-data
KLM_ENV=development

# Database (production — shared memory API + MCP)
DATABASE_URL=postgresql://klm:klm@localhost:5432/klm

# Model providers (BYOK — bring your own keys)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Default routing
KLM_DEFAULT_PROVIDER=openrouter
KLM_DEFAULT_MODEL=anthropic/claude-sonnet-4
