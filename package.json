{
  "name": "klm-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "KLM-∞ Runtime — stateful AI intelligence layer with replaceable model backends",
  "scripts": {
    "build": "pnpm -r run build",
    "dev:api": "pnpm --filter @klm/api dev",
    "dev:mcp": "pnpm --filter @klm/mcp-server dev",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r --if-present run test",
    "db:migrate": "pnpm --filter @klm/state-store db:migrate",
    "db:seed": "pnpm --filter @klm/state-store db:seed",
    "eval": "pnpm --filter @klm/evaluation eval",
    "eval:integration": "pnpm --filter @klm/evaluation eval:integration",
    "eval:codebase-index": "pnpm --filter @klm/evaluation eval:codebase-index",
    "index:codebase": "pnpm --filter @klm/codebase-indexer index",
    "index:music": "powershell -ExecutionPolicy Bypass -File scripts/index-music-platform.ps1",
    "smoke:music": "powershell -ExecutionPolicy Bypass -File scripts/smoke-music-platform.ps1",
    "klm:init": "node scripts/klm-init-cursor.mjs",
    "klm:project": "node scripts/klm-project.mjs",
    "klm:pin": "pnpm --filter @klm/bootstrap build && node --import tsx scripts/klm-pin-project.ts",
    "klm:import-docs": "pnpm --filter @klm/memory-core build && pnpm --filter @klm/state-store build && node scripts/klm-import-docs.mjs",
    "use:klm": "powershell -ExecutionPolicy Bypass -File scripts/use-profile.ps1 -Profile klm-runtime",
    "use:music": "powershell -ExecutionPolicy Bypass -File scripts/use-profile.ps1 -Profile music-platform",
    "setup:music": "powershell -ExecutionPolicy Bypass -File scripts/setup-music-project.ps1",
    "smoke:isolation": "pnpm --filter @klm/memory-core build && node scripts/smoke-project-isolation.mjs",
    "eval:e2e": "pnpm --filter @klm/evaluation eval:e2e",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "setup:local": "pnpm install && pnpm build && pnpm docker:up && pnpm db:migrate && pnpm db:seed",
    "record:demo": "pnpm --filter @klm/evaluation record:demo",
    "record:live": "pnpm --filter @klm/evaluation record:live",
    "smoke:observability": "powershell -ExecutionPolicy Bypass -File scripts/smoke-observability.ps1",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "devDependencies": {
    "@types/node": "^22.13.10",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  }
}
