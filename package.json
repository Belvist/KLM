{
  "name": "klm-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "KLM-∞ Runtime — stateful AI intelligence layer with replaceable model backends",
  "scripts": {
    "build": "pnpm -r run build",
    "dev:api": "pnpm --filter @klm/api dev",
    "dev:mcp": "pnpm --filter @klm/mcp-server dev",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "db:migrate": "pnpm --filter @klm/state-store db:migrate"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  }
}
