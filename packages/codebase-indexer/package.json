{
  "name": "@klm/codebase-indexer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "index": "node --import tsx src/cli.ts"
  },
  "dependencies": {
    "@klm/semantic-memory": "workspace:*",
    "pg": "^8.14.1",
    "typescript": "^5.8.2"
  },
  "devDependencies": {
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.3"
  }
}
